# Copy this file to .env and fill in real values. Never commit .env.
# Playwright reads these via dotenv in playwright.config.ts.

# App origin used as Playwright baseURL. Login is /users/sign_in (not /login).
BASE_URL=https://app.circle.so

# Dedicated test-account credentials — not a personal login.
TEST_EMAIL=your-email@example.com
TEST_PASSWORD=your-password